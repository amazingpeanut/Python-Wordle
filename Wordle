import sys

def load_words(file_name="words.txt"):
    try:
        # OnlineGDB looks for the file in the exact same tab panel
        with open(file_name, "r") as file:
            # Reads lines, removes hidden spacing, and creates a fast lookup set
            return set(line.strip().lower() for line in file)
    except FileNotFoundError:
        print(f"Error: Make sure you created a tab named 'words.txt'")
        return set()

